{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "alwaysStrict": true,
        "inlineSources": true,
        "isolatedModules": false,
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "removeComments": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "target": "esnext",
    },
    "compileOnSave": true,
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        ".vscode-test",
        "node_modules",
        "**/*.spec.ts"
    ]
}